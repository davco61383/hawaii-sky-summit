# Postgres (set automatically by the Vercel Marketplace Neon integration)
DATABASE_URL=
# Admin API token (long random string). Send as: Authorization: Bearer <token>
ADMIN_TOKEN=
# Set to 1 when the owner approves going public (enables indexing in robots.txt)
SITE_LIVE=
# Optional canonical URL, e.g. https://hawaii-sky-summit.vercel.app
NEXT_PUBLIC_SITE_URL=
# Optional, later: Resend (all no-ops when empty)
RESEND_API_KEY=
RESEND_AUDIENCE_ID=
RESEND_FROM=
NOTIFY_EMAIL=
